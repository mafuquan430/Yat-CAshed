From: Yat-CAShed <noreply@example.com>
Subject: [PATCH] sched/yat_casched: gate balance on a ready generation

Upstream: linux v6.8 (torvalds)

balance 回调此前每次都会调用 yat_update_ready_pool()，而后者要在
global_dag_lock 下遍历所有 DAG、每个 DAG 下再遍历所有作业。实测主口径下
balance_runs = 757 而唤醒只有 512 次，绝大多数调用发生时池里并没有新就绪
作业 —— 扫描与随后的取锁都是纯开销。

本补丁引入"就绪代际"：
  - 作业创建时无前驱、或最后一个前驱完成时，原子地把 yat_ready_gen 加一；
  - balance 只在新代际到来时扫描，并把 yat_scanned_gen 推进到快照值，
    并发就绪事件会让代际再次变化，因此不会漏扫；
  - 池空且代际未变时，balance 连 yat_balance_lock 都不取，直接返回。

新增三个计数器便于验收：balance_noop / pool_scans / pool_scan_skips。

---
--- a/kernel/sched/yat_casched.c
+++ b/kernel/sched/yat_casched.c
@@ -136,6 +136,25 @@
 static struct list_head global_dag_list = LIST_HEAD_INIT(global_dag_list); /* 活动DAG列表 */
 static DEFINE_SPINLOCK(global_dag_lock);                       /* DAG列表锁 */
 static struct yat_dag_task *global_default_dag;                /* 传统任务的默认DAG */
+
+/*
+ * 就绪代际（Route A）。
+ *
+ * 问题：balance 回调无条件调用 yat_update_ready_pool()，而它要在
+ * global_dag_lock 下遍历所有 DAG、每个 DAG 下再遍历所有作业。实测
+ * balance_runs = 757 而唤醒只有 512 次 —— 绝大多数调用发生时池里
+ * 并没有任何新东西，扫描纯属浪费；而且在 TCG 下每次取自旋锁都要
+ * 付出跨 vCPU 的代价。
+ *
+ * 做法：把"某个作业变成就绪"记成一个全局代际号 yat_ready_gen。
+ *   - 作业创建时无前驱            → 已就绪，代际 +1；
+ *   - 作业的最后一个前驱完成       → 就绪，代际 +1；
+ *   - balance 只在代际变化时扫描，并把 yat_scanned_gen 推进到快照值；
+ *   - 并发发生的就绪事件会让代际再次变化，因此不会漏扫。
+ * 池空且代际未变时，balance 连 yat_balance_lock 都不取就返回。
+ */
+static atomic_t yat_ready_gen = ATOMIC_INIT(0);		/* 就绪事件代际 */
+static atomic_t yat_scanned_gen = ATOMIC_INIT(-1);	/* 上次扫描看到的代际 */
 static atomic_t next_dag_id = ATOMIC_INIT(1);                  /* DAG ID分配器 */
 static atomic_t next_job_id = ATOMIC_INIT(1);                  /* 作业ID分配器 */
 
@@ -154,6 +173,9 @@
 struct yat_casched_stats {
 	u64 balance_runs;	/* balance 回调真正拿到全局锁的次数 */
 	u64 balance_skips;	/* 抢锁失败、本次跳过的次数（说明争用程度） */
+	u64 balance_noop;	/* 池空且无新就绪：连全局锁都没取的"空转"次数 */
+	u64 pool_scans;		/* 真正执行了就绪池全表扫描的次数 */
+	u64 pool_scan_skips;	/* 代际未变、跳过全表扫描的次数 */
 	u64 jobs_placed;	/* AJLR 成功完成 (job, cpu) 分配的次数 */
 	u64 jobs_nocore;	/* 就绪作业但找不到可用核心的次数 */
 	u64 history_records;	/* 写入历史表的执行区间条数 */
@@ -292,6 +314,9 @@
 {
 	seq_printf(m, "balance_runs      %llu\n", YAT_STAT_SUM(balance_runs));
 	seq_printf(m, "balance_skips     %llu\n", YAT_STAT_SUM(balance_skips));
+	seq_printf(m, "balance_noop      %llu\n", YAT_STAT_SUM(balance_noop));
+	seq_printf(m, "pool_scans        %llu\n", YAT_STAT_SUM(pool_scans));
+	seq_printf(m, "pool_scan_skips   %llu\n", YAT_STAT_SUM(pool_scan_skips));
 	seq_printf(m, "jobs_placed       %llu\n", YAT_STAT_SUM(jobs_placed));
 	seq_printf(m, "jobs_nocore       %llu\n", YAT_STAT_SUM(jobs_nocore));
 	seq_printf(m, "history_records   %llu\n", YAT_STAT_SUM(history_records));
@@ -889,6 +914,10 @@
     list_add_tail(&job->job_list, &dag->jobs);
     dag->total_jobs++;
     spin_unlock(&dag->lock);
+
+    /* 无前驱的作业创建即就绪，推进代际让 balance 扫到它 */
+    if (job->pending_predecessors == 0)
+        atomic_inc(&yat_ready_gen);
     
     return job;
 }
@@ -1001,6 +1030,9 @@
         list_del_init(&succ->predecessors);
         if (succ->pending_predecessors > 0)
             succ->pending_predecessors--;
+        /* 最后一个前驱完成 → 该作业就绪，推进代际 */
+        if (succ->pending_predecessors == 0)
+            atomic_inc(&yat_ready_gen);
     }
     return;
 
@@ -2084,6 +2116,23 @@
 
 int balance_yat_casched(struct rq *rq, struct task_struct *prev, struct rq_flags *rf)
 {
+    struct yat_ready_job_pool *pool = rq->yat_casched.ready_pool;
+
+    /*
+     * 快速路径（Route A）：就绪池为空，且自上次扫描以来没有任何作业
+     * 变成就绪 —— 这一轮 balance 不可能产出分配。此时连
+     * yat_balance_lock 都不取：实测 balance 的调用次数约为唤醒次数的
+     * 1.5 倍，其中绝大多数属于这种空转。
+     *
+     * 注意顺序：先读池长度、再读代际。若二者之间恰好有作业入池，
+     * 该入池者自己的 wakeup 路径会触发 resched，不会丢作业。
+     */
+    if (pool && READ_ONCE(pool->nr_jobs) == 0 &&
+        atomic_read(&yat_ready_gen) == atomic_read(&yat_scanned_gen)) {
+        YAT_STAT_INC(balance_noop);
+        return 0;
+    }
+
     if (!spin_trylock(&yat_balance_lock)) {
         /*
          * 抢不到锁说明另一颗 CPU 正在做全局分配。这个计数是「争用强度」
@@ -2478,6 +2527,8 @@
     if (!pool)
         return;
 
+    YAT_STAT_INC(pool_scans);
+
     spin_lock(&global_dag_lock);
     list_for_each_entry(dag, &global_dag_list, dag_list) {
         spin_lock(&dag->lock);
@@ -2525,6 +2576,23 @@
  * 要处理的作业；找不到核心时用 enqueue 放回（enqueue 会按优先级重新
  * 插位并恢复 state=READY，语义等价于"未取出"）。
  */
+/*
+ * 是否需要重新扫描就绪池？
+ *
+ * 返回 true 时顺手把"已扫描代际"推进到当前快照：若扫描期间又有就绪
+ * 事件发生，代际会再次不同，下一轮 balance 自然补扫，不会漏作业。
+ */
+static bool yat_ready_scan_needed(void)
+{
+	int gen = atomic_read(&yat_ready_gen);
+
+	if (gen == atomic_read(&yat_scanned_gen))
+		return false;
+
+	atomic_set(&yat_scanned_gen, gen);
+	return true;
+}
+
 void yat_schedule_ajlr(struct yat_casched_rq *rq)
 {
     struct yat_job *job;
@@ -2539,8 +2607,18 @@
     if (!pool)
         return;
 
-    /* 1. 更新就绪池 */
-    yat_update_ready_pool(rq);
+    /*
+     * 1. 更新就绪池 —— 仅当自上次扫描以来有作业变成就绪（Route A）。
+     *    没有新就绪作业且池子为空时，本轮不可能产出任何分配，
+     *    直接返回，连 DAG 链表都不遍历。
+     */
+    if (yat_ready_scan_needed()) {
+        yat_update_ready_pool(rq);
+    } else {
+        YAT_STAT_INC(pool_scan_skips);
+        if (READ_ONCE(pool->nr_jobs) == 0)
+            return;
+    }
 
     /*
      * 2. 循环分配。
