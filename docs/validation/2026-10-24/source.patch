-\textbf{1. CPU亲和性优化}
-\begin{code}
-int select_task_rq_yat_casched(struct task_struct *p,
-                               int task_cpu, int flags) {
-    // 核心策略：优先选择任务上次运行的CPU
-    if (p->yat_casched.last_cpu >= 0 && 
-        cpu_online(p->yat_casched.last_cpu)) {
-        return p->yat_casched.last_cpu;  // 优先选择上次CPU
-    }
-    return task_cpu;  // 回退到默认CPU分配
-}
-\end{code}
